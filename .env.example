# Copy to .env and change the password. .env is gitignored; this file is not, so keep it free of real secrets.
#
# The admin is created in auth-service's database the first time the stack starts with these set, and is
# re-checked on every boot after that. Changing ADMIN_PASSWORD here does NOT reset an admin that already
# exists -- that is deliberate, so a stale .env cannot hand the user back. Change it from /profile, or
# drop the volume with `./login-demo down --volumes` to start over.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-8-characters

# Shared between auth-service and agent-service: agent-service sends it when it asks auth-service to mint a
# 30-day agent token, and auth-service mints nothing without it. Any long random string; nobody types it.
INTERNAL_SECRET=change-me-too-any-long-random-string

# agent-service encrypts the authorization headers owners store on their MCP servers with this, AES-256-GCM. Any
# long random string; changing it after rows exist makes those headers unreadable, so keep it with the database.
AUTH_HEADER_KEY=change-me-three-any-long-random-string

# Sign-in with a provider. Every provider is off unless ENABLED is true AND every credential it needs is
# set -- half-filled credentials count as off, so a copied-and-unfinished .env draws no broken button.
#
# Step-by-step for getting a client id and secret from each provider, and for rotating one later:
#   apps/auth-service/README.md#getting-a-client-id-and-secret
#
# The short version -- register the callback URL with each provider exactly as written, host and port
# included, or it will refuse the redirect:
#   Google  console.cloud.google.com -> Google Auth Platform -> Clients -> Create client (Web application)
#           Authorized redirect URI:  http://localhost:3000/api/oauth/google/callback
#   GitHub  github.com/settings/developers -> OAuth apps -> New OAuth App
#           Authorization callback URL: http://localhost:3000/api/oauth/github/callback
#   Microsoft, Apple, X, LinkedIn, Discord: the same README, one section each. Apple needs HTTPS on a real
#           domain and a .p8 key rather than a secret; X needs the "Request email from users" app setting.
#
# Serving the frontend from somewhere other than localhost:3000 means changing OAUTH_REDIRECT_BASE_URL here
# and the registered URI there, together -- the provider rejects a redirect_uri it does not already know.
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

OAUTH_MICROSOFT_ENABLED=false
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Services ID, Team ID, Key ID, and the .p8 file's contents on one line with \n for the line breaks.
OAUTH_APPLE_ENABLED=false
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=

OAUTH_X_ENABLED=false
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=

OAUTH_LINKEDIN_ENABLED=false
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=

OAUTH_DISCORD_ENABLED=false
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
