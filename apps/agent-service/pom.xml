<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.demo</groupId>
        <artifactId>login-demo</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>agent-service</artifactId>
    <name>agent-service</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- The DTOs carry their own limits; the service checks them before anything reaches the database. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- /actuator/health for the compose healthcheck; nothing else is exposed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- The schema, as versioned SQL under db/migration; Hibernate only validates it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- ToolListCache: a downstream server's listing, kept 15s, bounded, one connection per concurrent miss. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- ErrorBodyAdvice and Bad.request: the {error} body every service answers a rejection with. -->
        <dependency>
            <groupId>com.demo</groupId>
            <artifactId>web-errors</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- JwtVerifier, Revocations and Caller: the one copy the three token-verifying services share. -->
        <dependency>
            <groupId>com.demo</groupId>
            <artifactId>auth-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- McpEndpoint and Args: the /mcp endpoint and tool-argument parsing the MCP-serving services share. -->
        <dependency>
            <groupId>com.demo</groupId>
            <artifactId>mcp-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- UrlPolicy: where an owner's MCP server may point. ServerUrls feeds it the two trusted-URL properties. -->
        <dependency>
            <groupId>com.demo</groupId>
            <artifactId>outbound-urls</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- EncryptedText: the stored authorization header, AES-256-GCM at rest, plain to the code. -->
        <dependency>
            <groupId>com.demo</groupId>
            <artifactId>jpa-crypto</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- MCP both ways: the server an external agent connects to, and the client that reaches the servers its
             owner attached. Version from the root BOM. -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PostgresIntegrationTests: the migrations and the queries against the real database, in a throwaway container. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchitectureTests: the package rules in the README, enforced. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
