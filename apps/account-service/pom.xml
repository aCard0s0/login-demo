<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.demo</groupId>
        <artifactId>login-demo</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>account-service</artifactId>
    <name>account-service</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- ErrorBodyAdvice: the {error} body every service answers a rejection with. -->
        <dependency>
            <groupId>com.demo</groupId>
            <artifactId>web-errors</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- JwtVerifier, Revocations and Caller: the one copy the three token-verifying services share. -->
        <dependency>
            <groupId>com.demo</groupId>
            <artifactId>auth-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- McpEndpoint and Args: the /mcp endpoint and tool-argument parsing the MCP-serving services share. -->
        <dependency>
            <groupId>com.demo</groupId>
            <artifactId>mcp-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The MCP server at /mcp, through which an agent reaches the accounts it owns or was granted. Version from the root BOM. -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
